intf_libs = # Interface dependencies.
import intf_libs += libvulkan-headers%lib{vulkan-headers}

lib{gpuperfapi-headers}: hxx{**} $intf_libs

# Build options.
#
out_pfx = [dir_path] $out_root/include/
src_pfx = [dir_path] $src_root/include/

cxx.poptions =+ "-I$out_pfx" "-I$src_pfx"

# Export options.
#
lib{gpuperfapi-headers}:
{
  cxx.export.poptions = "-I$out_pfx" "-I$src_pfx"
  cxx.export.libs = $intf_libs
}

# The interface loader (gpu_perf_api_interface_loader.h) loads the GPA
# runtime libraries with dlopen() on Linux.
#
if ($cxx.target.class == 'linux')
{
  cxx.libs += -ldl
  lib{gpuperfapi-headers}: cxx.export.libs += -ldl
}

# Install into the gpu_performance_api/ subdirectory of, say, /usr/include/
# recreating subdirectories.
#
hxx{*}:
{
  install         = include/gpu_performance_api/
  install.subdirs = true
}
